# Copy to .env and fill in. These ship in the app, so use only public/anon keys.
EXPO_PUBLIC_WARDROBE_API_URL=auto
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Set to 1 only after Sign in with Apple is set up (needs an Apple Developer account).
EXPO_PUBLIC_ENABLE_APPLE_SIGNIN=0
# RevenueCat public key. To try purchases without a store account, use a Test Store key (test_...).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro
# Which offering to show (leave empty for the project's current one).
EXPO_PUBLIC_REVENUECAT_OFFERING=
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
